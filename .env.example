# ---------------------------------------------------------------------------
# Pokora - environment variables
#
# Every variable below is OPTIONAL for local development. With an empty .env
# the app boots in full mock mode: in-memory storage, mock providers, and a
# development auth fallback. See README.md -> "Mockmodus".
# ---------------------------------------------------------------------------

# Public base URL of the app (used for magic-link redirects, canonical URLs
# and the sitemap). Defaults to http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase -------------------------------------------------------------
# Leave all three empty to run on the in-memory repository + local file store.
# Fill all three to switch the whole persistence layer to Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Private storage bucket used for uploaded images and generated crops.
SUPABASE_STORAGE_BUCKET=pokora-uploads

# --- Application mode -----------------------------------------------------
# mock | live
# mock  -> all providers use deterministic seeded fixtures
# live  -> providers are resolved from the *_PROVIDER variables below and fall
#          back to mock individually when their credentials are missing.
APP_MODE=mock

# Simulate provider failures in development to exercise error handling.
# none | recognition | catalog | pricing | detection
DEV_FORCE_PROVIDER_ERROR=none

# --- Limits and retention -------------------------------------------------
GUEST_ANALYSIS_TTL_HOURS=24
GUEST_MAX_IMAGES=3
USER_MAX_IMAGES=10
# Quota: counts only analyses that actually detected a card. A run that failed,
# or found nothing on a bad photo, does not consume it.
USER_DAILY_ANALYSIS_LIMIT=5
GUEST_DAILY_ANALYSIS_LIMIT=1

# Ceiling on attempts regardless of outcome. Keeps a failed photo free while
# still bounding the cost of repeated vision-model calls.
GUEST_DAILY_ATTEMPT_LIMIT=5
USER_DAILY_ATTEMPT_LIMIT=25
MAX_UPLOAD_BYTES=10485760

# Value (EUR) above which a card is flagged as "needs extra attention".
ATTENTION_VALUE_THRESHOLD_EUR=25

# --- AI vision (optional) -------------------------------------------------
# mock | anthropic | openai-compatible
AI_VISION_PROVIDER=mock
AI_VISION_API_KEY=
AI_VISION_MODEL=
AI_VISION_BASE_URL=

# --- Card catalog ---------------------------------------------------------
# mock | pokemontcg
CARD_CATALOG_PROVIDER=mock
CARD_CATALOG_API_KEY=
CARD_CATALOG_BASE_URL=https://api.pokemontcg.io/v2

# --- Pricing --------------------------------------------------------------
# mock | pokemontcg
PRICING_PROVIDER=mock
PRICING_API_KEY=

# --- Security -------------------------------------------------------------
# Salt used to hash IP addresses for rate limiting. IPs are never stored in
# plain text. Generate with: openssl rand -hex 32
RATE_LIMIT_SALT=change-me-in-production
RATE_LIMIT_ENABLED=true

# --- Auth development fallback -------------------------------------------
# When true and no Supabase project is configured, /login accepts any email
# and signs you in locally without sending mail. NEVER enable in production.
DEV_AUTH_FALLBACK=true

# --- Analytics ------------------------------------------------------------
# console | none
ANALYTICS_ADAPTER=console
